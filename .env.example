# Karimo - variables d'environnement
# Copier en .env et ajuster. Aucun secret n'est necessaire au jalon 1.

# Base de donnees (SQLite local par defaut)
KARIMO_DATABASE_URL=sqlite:///karimo.db

# Parametres financiers (voir SPEC 4.1). Montants en euros.
KARIMO_APPORT=200000
KARIMO_PLAFOND_PRIX=450000
KARIMO_TAUX_ANNUEL=0.046
KARIMO_DUREE_ANNEES=25

# Debours et frais d'acte du notaire, hors honoraires (SPEC : frais_divers)
KARIMO_DEBOURS=1300

# Frais lies a l'acte de credit
KARIMO_FRAIS_CREDIT_TAUX=0.01
KARIMO_FRAIS_CREDIT_FIXE=2200

# Mettre a 1 pour recalculer les honoraires avec l'approximation du SPEC
# (prix * 0.0115 + 800) au lieu du bareme officiel. Utile pour comparer.
KARIMO_HONORAIRES_APPROXIMATION=0
